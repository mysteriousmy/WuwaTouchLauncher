<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="launcher-backends" value="artifacts/linux-overlay/feed" />
    <add key="staticlink-ci" value="artifacts/p0/upstream-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="launcher-backends">
      <package pattern="Avalonia.Skia" />
      <package pattern="Avalonia.X11" />
      <package pattern="Avalonia.Wayland" />
    </packageSource>
    <packageSource key="staticlink-ci">
      <package pattern="StaticLink.Avalonia" />
      <package pattern="StaticLink.Avalonia.Native" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <!-- Unpatched 12.1.4 probes still restore from NuGet; the app pins the local 12.1.4.1 packages. -->
      <package pattern="Avalonia.Skia" />
      <package pattern="Avalonia.X11" />
      <package pattern="Avalonia.Wayland" />
    </packageSource>
  </packageSourceMapping>
</configuration>
